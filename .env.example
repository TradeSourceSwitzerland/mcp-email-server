# Copy to .env and replace placeholders. Never commit the real file.
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
MCP_BEARER_TOKEN=replace-with-a-random-token-at-least-32-characters

# Enabled by the selected policy
ALLOW_SEND=true
ALLOW_DRAFTS=true

# Account 1: info@tradesource.ch (IONOS)
EMAIL_ACCOUNT_1_NAME=info
EMAIL_ACCOUNT_1_ADDRESS=info@tradesource.ch
EMAIL_ACCOUNT_1_IMAP_HOST=imap.ionos.de
EMAIL_ACCOUNT_1_IMAP_PORT=993
EMAIL_ACCOUNT_1_IMAP_SECURE=true
EMAIL_ACCOUNT_1_IMAP_USER=info@tradesource.ch
EMAIL_ACCOUNT_1_IMAP_PASSWORD=replace-with-new-rotated-password-or-app-password
EMAIL_ACCOUNT_1_SMTP_HOST=smtp.ionos.de
EMAIL_ACCOUNT_1_SMTP_PORT=465
EMAIL_ACCOUNT_1_SMTP_SECURE=true
EMAIL_ACCOUNT_1_SMTP_USER=info@tradesource.ch
EMAIL_ACCOUNT_1_SMTP_PASSWORD=replace-with-new-rotated-password-or-app-password
