import { ImapFlow } from 'imapflow';
import { simpleParser } from 'mailparser';
import nodemailer from 'nodemailer';
import type { AccountConfig } from './config.js';

type AttachmentInfo = { filename?: string; contentType: string; size: number };

export function withImap<T>(account: AccountConfig, fn: (client: ImapFlow) => Promise<T>): Promise<T> {
  const client = new ImapFlow({ host: account.imap.host, port: account.imap.port, secure: account.imap.secure, auth: { user: account.imap.user, pass: account.imap.password }, logger: false });
  return client.connect().then(async () => {
    try { return await fn(client); } finally { await client.logout().catch(() => undefined); }
  });
}

export async function parseMessage(raw: Buffer | string) {
  const parsed = await simpleParser(raw);
  return {
    subject: parsed.subject ?? '', from: parsed.from?.text ?? '', to: parsed.to?.text ?? '',
    date: parsed.date?.toISOString() ?? null, text: parsed.text ?? '',
    html: parsed.html ? String(parsed.html) : null,
    attachments: parsed.attachments.map((a: AttachmentInfo) => ({ filename: a.filename, contentType: a.contentType, size: a.size }))
  };
}

export function findSentMailbox(boxes: Array<{ path: string; specialUse?: string | null }>): string | null {
  const match = boxes.find((box) => {
    const specialUse = (box.specialUse ?? '').split(/\s+/).filter(Boolean).map((value) => value.toLowerCase());
    return specialUse.includes('\\sent') || specialUse.includes('sent') || box.path.toLowerCase() === 'sent' || box.path.toLowerCase() === 'sent items';
  });
  return match?.path ?? null;
}

export function buildSentMessage({ from, to, cc, subject, text, date, messageId }: {
  from: string; to: string; cc?: string; subject: string; text: string; date?: string | Date; messageId: string;
}): string {
  const lineBreak = '\r\n';
  const normalizedSubject = subject.replace(/[\r\n]+/g, ' ').trim();
  const headers = [
    `From: ${from}`,
    `To: ${to}`,
    cc ? `Cc: ${cc}` : '',
    `Subject: ${normalizedSubject}`,
    `Date: ${new Date(date ?? Date.now()).toUTCString()}`,
    `Message-ID: ${messageId}`,
    'MIME-Version: 1.0',
    'Content-Type: text/plain; charset=utf-8',
    ''
  ].filter((line) => line !== '');

  return `${headers.join(lineBreak)}${lineBreak}${text}`;
}

export async function appendSentCopy(account: AccountConfig, message: string): Promise<string> {
  return withImap(account, async (client) => {
    const boxes = await client.list();
    const mailbox = findSentMailbox(boxes);
    if (!mailbox) throw new Error('No IMAP mailbox with special-use flag \\Sent found');
    await client.append(mailbox, message, { flags: ['\\Seen'] });
    return mailbox;
  });
}

export function smtp(account: AccountConfig) {
  return nodemailer.createTransport({ host: account.smtp.host, port: account.smtp.port, secure: account.smtp.secure, auth: { user: account.smtp.user, pass: account.smtp.password } });
}
